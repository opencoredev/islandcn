{
  "name": "islandcn",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source Dynamic Island for React: a spring-driven island engine, shadcn registry presets and an agent skill.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && pnpm docs:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "registry:build": "jiti scripts/build-registry.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=180000 tests/*.test.ts",
    "docs:build": "jiti scripts/build-docs.ts",
    "docs:dev": "cd docs && blume dev",
    "docs:validate": "cd docs && blume validate --strict"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-ui": "16.17.9",
    "geist": "1.8.2",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "blume": "2.2.7",
    "jiti": "2.7.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.10",
    "shadcn": "4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.7"
}
